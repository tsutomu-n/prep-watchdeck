{
  "$defs": {
    "AuditCounts": {
      "additionalProperties": false,
      "properties": {
        "expectedBars": {
          "minimum": 0,
          "title": "Expectedbars",
          "type": "integer"
        },
        "commonValidBars": {
          "minimum": 0,
          "title": "Commonvalidbars",
          "type": "integer"
        },
        "comparedPriceValues": {
          "minimum": 0,
          "title": "Comparedpricevalues",
          "type": "integer"
        },
        "comparedVolumeValues": {
          "minimum": 0,
          "title": "Comparedvolumevalues",
          "type": "integer"
        },
        "expectedReturnPairs": {
          "minimum": 0,
          "title": "Expectedreturnpairs",
          "type": "integer"
        },
        "returnPairs": {
          "minimum": 0,
          "title": "Returnpairs",
          "type": "integer"
        },
        "priceDifferenceValues": {
          "minimum": 0,
          "title": "Pricedifferencevalues",
          "type": "integer"
        },
        "priceDifferenceBars": {
          "minimum": 0,
          "title": "Pricedifferencebars",
          "type": "integer"
        },
        "volumeDifferenceValues": {
          "minimum": 0,
          "title": "Volumedifferencevalues",
          "type": "integer"
        },
        "returnDifferencePairs": {
          "minimum": 0,
          "title": "Returndifferencepairs",
          "type": "integer"
        },
        "leftMissingBars": {
          "minimum": 0,
          "title": "Leftmissingbars",
          "type": "integer"
        },
        "rightMissingBars": {
          "minimum": 0,
          "title": "Rightmissingbars",
          "type": "integer"
        },
        "leftInvalidBars": {
          "minimum": 0,
          "title": "Leftinvalidbars",
          "type": "integer"
        },
        "rightInvalidBars": {
          "minimum": 0,
          "title": "Rightinvalidbars",
          "type": "integer"
        },
        "missingValueCount": {
          "minimum": 0,
          "title": "Missingvaluecount",
          "type": "integer"
        },
        "returnMissingPairs": {
          "minimum": 0,
          "title": "Returnmissingpairs",
          "type": "integer"
        },
        "totalFindings": {
          "minimum": 0,
          "title": "Totalfindings",
          "type": "integer"
        },
        "completeForRequestedChecks": {
          "title": "Completeforrequestedchecks",
          "type": "boolean"
        },
        "maxFlaggedPriceDiffBps": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maxflaggedpricediffbps"
        },
        "maxFlaggedReturnDiffBps": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maxflaggedreturndiffbps"
        }
      },
      "required": [
        "expectedBars",
        "commonValidBars",
        "comparedPriceValues",
        "comparedVolumeValues",
        "expectedReturnPairs",
        "returnPairs",
        "priceDifferenceValues",
        "priceDifferenceBars",
        "volumeDifferenceValues",
        "returnDifferencePairs",
        "leftMissingBars",
        "rightMissingBars",
        "leftInvalidBars",
        "rightInvalidBars",
        "missingValueCount",
        "returnMissingPairs",
        "totalFindings",
        "completeForRequestedChecks",
        "maxFlaggedPriceDiffBps",
        "maxFlaggedReturnDiffBps"
      ],
      "title": "AuditCounts",
      "type": "object"
    },
    "AuditIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "runId": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Runid",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/AuditTarget"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "checkedAt": {
          "format": "date-time",
          "title": "Checkedat",
          "type": "string"
        },
        "comparisonKind": {
          "enum": [
            "snapshot_revision",
            "acquisition_routes",
            "repeatability"
          ],
          "title": "Comparisonkind",
          "type": "string"
        },
        "evidenceKind": {
          "enum": [
            "observed",
            "synthetic"
          ],
          "title": "Evidencekind",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/AuditWindow"
        },
        "execution": {
          "enum": [
            "completed",
            "invalid_input",
            "failed"
          ],
          "title": "Execution",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "match",
                "differences",
                "incomplete",
                "unverified"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Errorcode"
        },
        "inputs": {
          "$ref": "#/$defs/AuditInputs"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuditCounts"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCompletedRunId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lastcompletedrunid"
        }
      },
      "required": [
        "runId",
        "target",
        "startedAt",
        "checkedAt",
        "comparisonKind",
        "evidenceKind",
        "window",
        "execution",
        "outcome",
        "errorCode",
        "inputs",
        "summary",
        "lastCompletedRunId"
      ],
      "title": "AuditIndexEntry",
      "type": "object"
    },
    "AuditInputEvidence": {
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Sourceid",
          "type": "string"
        },
        "label": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Label",
          "type": "string"
        },
        "snapshotCreatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshotcreatedat"
        },
        "fileSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Filesha256"
        },
        "sourceTimeMissingCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sourcetimemissingcount"
        },
        "derivedFinalCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Derivedfinalcount"
        }
      },
      "required": [
        "sourceId",
        "label",
        "snapshotCreatedAt",
        "fileSha256",
        "sourceTimeMissingCount",
        "derivedFinalCount"
      ],
      "title": "AuditInputEvidence",
      "type": "object"
    },
    "AuditInputs": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/AuditInputEvidence"
        },
        "right": {
          "$ref": "#/$defs/AuditInputEvidence"
        }
      },
      "required": [
        "left",
        "right"
      ],
      "title": "AuditInputs",
      "type": "object"
    },
    "AuditTarget": {
      "additionalProperties": false,
      "properties": {
        "venueInstrumentId": {
          "maxLength": 160,
          "pattern": "^(bitget|hyperliquid|aster):[^\\x00-\\x20\\x7f]+$",
          "title": "Venueinstrumentid",
          "type": "string"
        },
        "venueInstrumentVersionId": {
          "minimum": 1,
          "title": "Venueinstrumentversionid",
          "type": "integer"
        }
      },
      "required": [
        "venueInstrumentId",
        "venueInstrumentVersionId"
      ],
      "title": "AuditTarget",
      "type": "object"
    },
    "AuditWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "dataAsOf": {
          "format": "date-time",
          "title": "Dataasof",
          "type": "string"
        },
        "sourceIntervalSeconds": {
          "const": 60,
          "title": "Sourceintervalseconds",
          "type": "integer"
        },
        "returnMinutes": {
          "const": 5,
          "title": "Returnminutes",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "dataAsOf",
        "sourceIntervalSeconds",
        "returnMinutes"
      ],
      "title": "AuditWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/AuditIndexEntry"
      },
      "maxItems": 256,
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "entries"
  ],
  "title": "AuditIndex",
  "type": "object"
}
