    "engineVersion": {
      "title": "Engineversion",
      "type": "string"
    },
    "featureVersion": {
      "title": "Featureversion",
      "type": "string"
    },
    "rulesetVersion": {
      "title": "Rulesetversion",
      "type": "string"
    },
    "configHash": {
      "title": "Confighash",
      "type": "string"
    },
    "runId": {
      "title": "Runid",
      "type": "string"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "integer"
    },
    "dataAsOf": {
      "title": "Dataasof",
      "type": "integer"
    },
    "snapshotStatus": {
      "$ref": "#/$defs/SnapshotStatus"
