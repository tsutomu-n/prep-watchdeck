        "id",
        "policyId",
        "identityKey",
        "assetId",
        "asset",
        "referenceKey",
        "originals",
        "state",
        "startKind",
        "firstObservedAt",
        "lastConfirmedAt",
        "consecutiveConfirmations",
        "observedDurationMs",
        "endedAt",
        "endReason",
        "interruptionReason",
