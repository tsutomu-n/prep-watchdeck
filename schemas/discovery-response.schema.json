        "firstSourceGenerationId": {
          "title": "Firstsourcegenerationid",
          "type": "string"
        },
        "lastSourceGenerationId": {
          "title": "Lastsourcegenerationid",
          "type": "string"
        },
        "firstRankingCutoff": {
