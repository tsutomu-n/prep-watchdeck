          "type": "string"
        },
        "identityKey": {
          "title": "Identitykey",
          "type": "string"
        },
        "assetId": {
          "title": "Assetid",
          "type": "string"
        },
        "asset": {
          "title": "Asset",
          "type": "string"
        },
        "referenceKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Referencekey"
        },
        "originals": {
          "items": {
            "$ref": "#/$defs/OriginalReference"
          },
          "title": "Originals",
          "type": "array"
