        "firstObservedAt": {
          "title": "Firstobservedat",
          "type": "integer"
        },
        "lastConfirmedAt": {
          "title": "Lastconfirmedat",
          "type": "integer"
        },
        "consecutiveConfirmations": {
          "minimum": 1,
          "title": "Consecutiveconfirmations",
          "type": "integer"
        },
        "observedDurationMs": {
          "minimum": 0,
          "title": "Observeddurationms",
          "type": "integer"
        },
        "endedAt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endedat"
