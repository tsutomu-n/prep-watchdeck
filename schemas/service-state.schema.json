{
  "$defs": {
    "ArtifactFileStatus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "generatedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generatedat"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Errorcode"
        }
      },
      "required": [
        "name",
        "status",
        "generatedAt",
        "errorCode"
      ],
      "title": "ArtifactFileStatus",
      "type": "object"
    },
    "CollectorRunArtifact": {
      "additionalProperties": false,
      "properties": {
        "runKind": {
          "enum": [
            "catalog",
            "l1"
          ],
          "title": "Runkind",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "title": "Startedat",
          "type": "string"
        },
        "completedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completedat"
        },
        "cycleAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cycleat"
        },
        "ageSeconds": {
          "minimum": 0,
          "title": "Ageseconds",
          "type": "number"
        },
        "recordsReceived": {
          "minimum": 0,
          "title": "Recordsreceived",
          "type": "integer"
        },
        "recordsWritten": {
          "minimum": 0,
          "title": "Recordswritten",
          "type": "integer"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Errorcode"
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/PersistedCycleDiagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "runKind",
        "status",
        "startedAt",
        "completedAt",
        "cycleAt",
        "ageSeconds",
        "recordsReceived",
        "recordsWritten",
        "errorCode"
      ],
      "title": "CollectorRunArtifact",
      "type": "object"
    },
    "FreshnessArtifact": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "unavailable",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "latestAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latestat"
        },
        "ageSeconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ageseconds"
        },
        "maxAgeSeconds": {
          "exclusiveMinimum": 0,
          "title": "Maxageseconds",
          "type": "number"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Errorcode"
        }
      },
      "required": [
        "status",
        "latestAt",
        "maxAgeSeconds",
        "errorCode"
      ],
      "title": "FreshnessArtifact",
      "type": "object"
    },
    "PersistedCycleDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "persisted-l1-diagnostics-v1",
          "default": "persisted-l1-diagnostics-v1",
          "title": "Schemaversion",
          "type": "string"
        },
        "cycleAt": {
          "format": "date-time",
          "title": "Cycleat",
          "type": "string"
        },
        "venues": {
          "items": {
            "$ref": "#/$defs/PersistedVenueDiagnostics"
          },
          "maxItems": 4,
          "title": "Venues",
          "type": "array"
        }
      },
      "required": [
        "cycleAt",
        "venues"
      ],
      "title": "PersistedCycleDiagnostics",
      "type": "object"
    },
    "PersistedDiagnosticExample": {
      "additionalProperties": false,
      "properties": {
        "venueInstrumentId": {
          "title": "Venueinstrumentid",
          "type": "string"
        },
        "venueInstrumentVersionId": {
          "exclusiveMinimum": 0,
          "title": "Venueinstrumentversionid",
          "type": "integer"
        },
        "status": {
          "enum": [
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "errorCode": {
          "title": "Errorcode",
          "type": "string"
        },
        "missingFields": {
          "items": {
            "type": "string"
          },
          "title": "Missingfields",
          "type": "array"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "sourceAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sourceat"
        }
      },
      "required": [
        "venueInstrumentId",
        "venueInstrumentVersionId",
        "status",
        "errorCode",
        "missingFields",
        "observedAt",
        "sourceAt"
      ],
      "title": "PersistedDiagnosticExample",
      "type": "object"
    },
    "PersistedQualityCounts": {
      "additionalProperties": false,
      "properties": {
        "ready": {
          "minimum": 0,
          "title": "Ready",
          "type": "integer"
        },
        "partial": {
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        },
        "unavailable": {
          "minimum": 0,
          "title": "Unavailable",
          "type": "integer"
        }
      },
      "required": [
        "ready",
        "partial",
        "unavailable"
      ],
      "title": "PersistedQualityCounts",
      "type": "object"
    },
    "PersistedReasonCount": {
      "additionalProperties": false,
      "properties": {
        "errorCode": {
          "title": "Errorcode",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "errorCode",
        "count"
      ],
      "title": "PersistedReasonCount",
      "type": "object"
    },
    "PersistedVenueDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "venue": {
          "enum": [
            "bitget",
            "hyperliquid",
            "aster",
            "mexc"
          ],
          "title": "Venue",
          "type": "string"
        },
        "qualityCounts": {
          "$ref": "#/$defs/PersistedQualityCounts"
        },
        "reasonCounts": {
          "items": {
            "$ref": "#/$defs/PersistedReasonCount"
          },
          "maxItems": 64,
          "title": "Reasoncounts",
          "type": "array"
        },
        "explainedPartialCount": {
          "minimum": 0,
          "title": "Explainedpartialcount",
          "type": "integer"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/PersistedDiagnosticExample"
          },
          "maxItems": 8,
          "title": "Examples",
          "type": "array"
        }
      },
      "required": [
        "venue",
        "qualityCounts",
        "reasonCounts",
        "explainedPartialCount",
        "examples"
      ],
      "title": "PersistedVenueDiagnostics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "unavailable",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "qualityReasons": {
      "items": {
        "type": "string"
      },
      "title": "Qualityreasons",
      "type": "array"
    },
    "collectors": {
      "items": {
        "$ref": "#/$defs/CollectorRunArtifact"
      },
      "title": "Collectors",
      "type": "array"
    },
    "catalog": {
      "$ref": "#/$defs/FreshnessArtifact"
    },
    "l1": {
      "$ref": "#/$defs/FreshnessArtifact"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactFileStatus"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "status",
    "qualityReasons",
    "collectors",
    "catalog",
    "l1",
    "artifacts"
  ],
  "title": "MarketServiceStateArtifact",
  "type": "object"
}
