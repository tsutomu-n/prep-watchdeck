# Runtime state
# Leave unset to use repo/var. Set one absolute path for Repo-external state.
# PREP_WATCHDECK_STATE_DIR=/home/you/.local/share/prep-watchdeck

# scanner-core source/config paths
# These paths are relative to apps/scanner-core for direct `uv run watchdeck ...`.
PREP_WATCHDECK_CONFIG_DIR=../../config/scanner-filters
PREP_WATCHDECK_FIXTURES_DIR=../../fixtures
PREP_WATCHDECK_SCHEMA_PATH=../../schemas/scanner-snapshot.schema.json
PREP_WATCHDECK_DEFAULT_TEMPLATE=balanced
PREP_WATCHDECK_PRODUCT_TYPE=USDT-FUTURES
PREP_WATCHDECK_LOG_LEVEL=INFO
PREP_WATCHDECK_LIVE_MAX_SYMBOLS=30
PREP_WATCHDECK_LIVE_CANDLE_CONCURRENCY=8
PREP_WATCHDECK_LIVE_TEMPLATE=balanced

# repo scripts
LIVE_MAX_SYMBOLS=30
TEMPLATE=balanced
PORT=5173

# Compatibility overrides
# Prefer PREP_WATCHDECK_STATE_DIR. Uncomment individual paths only when needed.
# PREP_WATCHDECK_CACHE_DB_PATH=/absolute/path/watchdeck.duckdb
# PREP_WATCHDECK_OUT_DIR=/absolute/path/snapshots
# PREP_WATCHDECK_SERVICE_STATE_PATH=/absolute/path/service-state.json
# PREP_WATCHDECK_TICKER_RUNTIME_PATH=/absolute/path/ticker-runtime.json
# PREP_WATCHDECK_PAST_NOTES_DIR=/absolute/path/past-notes
# PREP_WATCHDECK_DASHBOARD_VIEW_SETTINGS_DIR=/absolute/path/dashboard-view-settings
# SCANNER_SNAPSHOT_PATH=/absolute/path/latest.json
# SCANNER_SERVICE_STATE_PATH=/absolute/path/service-state.json
# SCANNER_TICKER_RUNTIME_PATH=/absolute/path/ticker-runtime.json
# SCANNER_CHARTS_DIR=/absolute/path/charts/latest
