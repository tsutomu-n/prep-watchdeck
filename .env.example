# Public market runtime
# The default state root is shown here explicitly for local operators.
PREP_WATCHDECK_MARKET_STATE_DIR=/home/you/.local/share/prep-watchdeck-market
PREP_WATCHDECK_MARKET_LOG_LEVEL=INFO

# Dedicated Postgres. Keep the real credential in
# ~/.config/prep-watchdeck-market/postgres.env with mode 0600, not in this file.
PREP_WATCHDECK_MARKET_ENV_FILE=/home/you/.config/prep-watchdeck-market/postgres.env
# PREP_WATCHDECK_MARKET_DATABASE_URL=postgresql://prep_watchdeck_market:<url-encoded-secret>@127.0.0.1:55432/prep_watchdeck_market

# Local Web
PORT=5173
